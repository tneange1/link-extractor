# Пароль для страницы «Экстрактор ссылок»
ADMIN_PASSWORD=change_me

# Куда проксировать запросы подписки (контейнер страницы подписки Remnawave)
UPSTREAM_URL=http://remnawave-subscription-page:3010

# API панели: добавлять ключи только юзерам со статусом ACTIVE
REMNAWAVE_API_URL=http://remnawave:3000
REMNAWAVE_API_TOKEN=
ONLY_ACTIVE_USERS=true

# Если в subscription-page задан CUSTOM_SUB_PREFIX — укажи его тут же
SUB_PATH_PREFIX=

# Путь страницы экстрактора
BASE_PATH=/link-extractor

# Как часто обновлять подписки-источники (мин)
REFRESH_MINUTES=10

# Домен панели (для добавления пункта «Экстрактор ссылок» в меню)
PANEL_DOMAIN=
PANEL_UPSTREAM_URL=http://remnawave:3000

# Telegram-уведомления (новые/пропавшие ключи, ошибки подписок, обновления)
TG_BOT_TOKEN=
TG_CHAT_ID=
# TG_THREAD_ID=   # если чат с топиками

# Автообновление с GitHub
AUTO_UPDATE=true
UPDATE_INTERVAL_MINUTES=10
UPDATE_BRANCH=main

# Что запускать на этом сервере: extractor | bot | extractor,bot
COMPOSE_PROFILES=extractor
# Название панели (видно в уведомлениях и в боте)
PANEL_NAME=
# Токен для управления из бота (Authorization: Bearer ...). Если пусто — подходит ADMIN_PASSWORD
API_TOKEN=

# Бэкапы
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=14
BACKUP_TO_TELEGRAM=true
# Бэкап БД Remnawave (pg_dumpall из контейнера remnawave-db)
BACKUP_PANEL_DB=false
PANEL_DB_CONTAINER=remnawave-db

# --- Бот (COMPOSE_PROFILES=bot) ---
# Telegram id админов через запятую — только они могут управлять ботом
TG_ADMIN_IDS=
