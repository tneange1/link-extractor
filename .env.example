# В .env — только это. Всё остальное (пароль страницы, API-токен, токен Remnawave, название,
# домен, автообновление, бэкапы, уведомления) хранится в базе и настраивается в боте или на странице.

# Что запускать на этом сервере: extractor | bot | extractor,bot
COMPOSE_PROFILES=extractor

# Токен бота от @BotFather (бот и уведомления)
TG_BOT_TOKEN=

# Telegram id админов через запятую (узнать: @userinfobot)
TG_ADMIN_IDS=
